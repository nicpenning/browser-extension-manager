{
  "manifest_version": 3,
  "name": "Extension Management",
  "version": "1.0",
  "description": "View information about installed extensions",
  "author": "Michael Hanson",
  "permissions": [
    "management",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
